@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("Name");
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - RaceDay</title>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark rd-nav">
  <div class="container">
    <a class="navbar-brand rd-logo" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div id="nav" class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        @if (role == "Organiser")
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage Events</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">New Event</a></li>
        }
        else if (role == "Participant")
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Events</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
        }
      </ul>
      <ul class="navbar-nav align-items-lg-center">
        @if (role is null)
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
          <li class="nav-item"><a class="btn btn-rd ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
        }
        else
        {
          <li class="nav-item text-white me-3">Hi, @name <span class="badge bg-rd">@role</span></li>
          <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form></li>
        }
      </ul>
    </div>
  </div>
</nav>

<main class="container py-4">
  @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
  @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
  @RenderBody()
</main>
<footer class="rd-footer text-center py-3">RaceDay &copy; @DateTime.Now.Year - South Africa's road events platform</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
