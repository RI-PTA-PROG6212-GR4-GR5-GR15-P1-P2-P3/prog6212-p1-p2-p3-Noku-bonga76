@model List<EventDto>
@{ ViewData["Title"] = "Manage Events"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="rd-h mb-0">Manage Events</h2><a class="btn btn-rd" asp-action="CreateEvent">+ New Event</a></div>
<div class="table-responsive"><table class="table rd-table align-middle">
  <thead><tr><th>Name</th><th>Date</th><th>Location</th><th>Type</th><th>km</th><th></th></tr></thead>
  <tbody>
  @foreach (var e in Model) {
    <tr><td>@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.EventType</td><td>@e.Distance</td>
    <td class="text-end text-nowrap">
      <a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-id="@e.Id">Categories</a>
      <a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-id="@e.Id">Enrolments</a>
      <a class="btn btn-sm btn-outline-dark" asp-action="Results" asp-route-id="@e.Id">Results</a>
      <a class="btn btn-sm btn-rd" asp-action="EditEvent" asp-route-id="@e.Id">Edit</a>
      <form asp-action="DeleteEvent" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');"><button class="btn btn-sm btn-danger">Delete</button></form>
    </td></tr>
  }
  </tbody></table></div>
