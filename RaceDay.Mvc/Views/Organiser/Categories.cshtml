@model CategoriesVm
@{ ViewData["Title"] = "Categories"; }
<h2 class="rd-h">Categories - @Model.Event.Name</h2>
<form asp-action="AddCategory" asp-route-id="@Model.Event.Id" method="post" class="row g-2 mb-4" style="max-width:560px">
  <div class="col-12"><input name="name" class="form-control" placeholder="e.g. Under 20, Senior, 10km, 21km" required /></div>
  <div class="col-12"><input name="description" class="form-control" placeholder="Description (optional)" /></div>
  <div class="col-12"><button class="btn btn-rd">Add category</button></div>
</form>
<ul class="list-group" style="max-width:560px">
@foreach (var c in Model.Categories) {
  <li class="list-group-item d-flex justify-content-between align-items-center">@c.CategoryName@if (!string.IsNullOrEmpty(c.Description)) { <small class="text-muted"> - @c.Description</small> }
    <form asp-action="DeleteCategory" asp-route-id="@Model.Event.Id" asp-route-categoryId="@c.Id" method="post"><button class="btn btn-sm btn-outline-danger">Remove</button></form></li>
}
@if (!Model.Categories.Any()) { <li class="list-group-item text-muted">No categories yet.</li> }
</ul>
<a class="btn btn-link mt-3" asp-action="Events">&larr; Back</a>
